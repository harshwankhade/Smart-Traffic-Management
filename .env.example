# Configuration examples only. Scripts do not automatically load .env files.
APP_ENV=local
LOCAL_HOST=127.0.0.1
# Approved planned region, not provisioning approval:
AWS_REGION=ap-south-1
# Local defaults are separate files under the project root's .data/ directory.
# These optional overrides use paths relative to the process working directory:
SENSOR_REGISTRY_DATABASE_URL=sqlite:///.data/registry.db
INCIDENT_MANAGER_DATABASE_URL=sqlite:///.data/incidents.db
SENSOR_REGISTRY_URL=http://127.0.0.1:8001
# Real local Kafka bootstrap uses scripts/phase3_local.py; no AWS deployment.
KAFKA_RAW_TOPIC=traffic.raw
KAFKA_RESULTS_TOPIC=traffic.results
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_AUTH_MODE=local
PUBLISHER_GRPC_BIND=127.0.0.1:50051
PUBLISHER_GRPC_TARGET=127.0.0.1:50051
PUBLISHER_HTTP_URL=http://127.0.0.1:8003
ARCHIVE_MODE=local
ARCHIVE_ENDPOINT_URL=http://127.0.0.1:8333
ARCHIVE_BUCKET=traffic-archive
# Generate local-only credentials with phase3_local.py configure; use --phase3-local
# when launching Publisher/Ingestion. Never copy real AWS keys into this file.
# Use workload IAM/default credential providers in future cloud code.
# Never place real access keys, passwords or tokens in this file.
