{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smart-traffic:v1:sensor",
  "title": "sensor v1 approved planned contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intersection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "inactive"
      ]
    }
  },
  "required": [
    "schema_version",
    "sensor_id",
    "intersection_id",
    "location",
    "status"
  ]
}
