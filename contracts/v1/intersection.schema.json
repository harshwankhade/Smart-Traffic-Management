{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smart-traffic:v1:intersection",
  "title": "intersection v1 approved Phase 2 contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "intersection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "intersection_id",
    "name",
    "location"
  ]
}
