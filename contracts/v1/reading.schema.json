{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smart-traffic:v1:reading",
  "title": "reading v1 approved planned contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intersection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "vehicle_count": {
      "type": "integer",
      "minimum": 0
    },
    "average_speed": {
      "type": "number",
      "minimum": 0
    },
    "occupancy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "sensor_id",
    "intersection_id",
    "observed_at"
  ],
  "anyOf": [
    {
      "required": [
        "vehicle_count"
      ]
    },
    {
      "required": [
        "average_speed"
      ]
    },
    {
      "required": [
        "occupancy"
      ]
    }
  ]
}
