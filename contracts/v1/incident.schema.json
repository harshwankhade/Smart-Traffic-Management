{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smart-traffic:v1:incident",
  "title": "incident v1 approved planned contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intersection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "enum": [
        "collision",
        "closure",
        "disruption"
      ]
    },
    "status": {
      "enum": [
        "open",
        "resolved"
      ]
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema_version",
    "incident_id",
    "intersection_id",
    "event_id",
    "type",
    "status",
    "reported_at",
    "updated_at",
    "description"
  ]
}
